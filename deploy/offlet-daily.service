[Unit]
Description=OFFLet daily reminders, payouts, and retention check
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=offlet
Group=offlet
SupplementaryGroups=www-data
WorkingDirectory=/srv/offlet/offlet
EnvironmentFile=/srv/offlet/offlet/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash /srv/offlet/offlet/deploy/run-daily-jobs.sh
